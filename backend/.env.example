PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins. 5176 is included because Vite may use it when 5173 is busy.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5176
